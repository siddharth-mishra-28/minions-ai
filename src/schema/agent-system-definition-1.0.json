{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minions-assembler/schema/agent-system-definition-1.0.json",
  "title": "Agent System Definition v1.0",
  "description": "A team of independently stored, version-pinned agents plus the workflows that orchestrate them. Never embeds an AgentDefinition: members reference registered agents by id + definition hash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "metadata", "team", "orchestration"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "agent-system" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$", "description": "Stable slug, e.g. software-delivery-team" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-.][0-9A-Za-z.]+)?$" },
        "description": { "type": "string", "maxLength": 4000 },
        "tags": { "type": "array", "items": { "type": "string", "maxLength": 60 }, "maxItems": 40 }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["members"],
      "properties": {
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": { "$ref": "#/$defs/member" }
        }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultWorkflowId", "workflows"],
      "properties": {
        "defaultWorkflowId": { "type": "string", "minLength": 1 },
        "communication": { "$ref": "#/$defs/communication" },
        "workflows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/workflow" }
        }
      }
    }
  },
  "$defs": {
    "agentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId"],
      "properties": {
        "agentId": { "type": "string", "minLength": 1, "maxLength": 200, "description": "name@version of a registered agent" },
        "version": { "type": "string", "maxLength": 60, "description": "Pinned definition version (metadata.version)" },
        "definitionHash": { "type": "string", "maxLength": 80, "description": "Pinned definition hash; immutable during a run" }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memberId", "role", "agentRef"],
      "properties": {
        "memberId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "role": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reportsTo": { "type": "string", "maxLength": 64 },
        "workspace": {
          "type": "string",
          "enum": ["isolated", "shared"],
          "description": "isolated (default) gives the member its own directory under members/<id>; shared puts every member in the run workspace so a delivery team can build one repository together."
        },
        "agentRef": { "$ref": "#/$defs/agentRef" },
        "delegation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "allowedMemberIds": { "type": "array", "items": { "type": "string" }, "maxItems": 40 },
            "maxDepth": { "type": "integer", "minimum": 1, "maximum": 8 },
            "maxConcurrentDelegates": { "type": "integer", "minimum": 1, "maximum": 16 }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "canReview": { "type": "boolean" },
            "canApprove": { "type": "boolean" },
            "canDelegate": { "type": "boolean" }
          }
        },
        "instructions": { "type": "string", "maxLength": 8000 }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Dot path into the node output, e.g. output.status" },
        "operator": { "enum": ["equals", "not-equals", "in", "contains", "exists", "gt", "lt", "gte", "lte", "matches"] },
        "value": {}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "type"],
      "properties": {
        "nodeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "type": { "enum": ["agent-task", "manager", "join", "human-approval", "terminal"] },
        "memberId": { "type": "string", "maxLength": 64 },
        "label": { "type": "string", "maxLength": 120 },
        "task": { "type": "string", "maxLength": 8000 },
        "outputContract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifactTypes": { "type": "array", "items": { "type": "string", "maxLength": 80 }, "maxItems": 20 },
            "required": { "type": "boolean" }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt": { "type": "string", "maxLength": 2000 },
            "role": { "type": "string", "maxLength": 120 }
          }
        },
        "join": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "mode": { "enum": ["all", "any"] } }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "when": { "$ref": "#/$defs/condition" },
        "label": { "type": "string", "maxLength": 80 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowId", "name", "mode", "entryNodeId", "nodes", "edges"],
      "properties": {
        "workflowId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "mode": { "enum": ["sequential", "parallel", "hierarchical", "hybrid"] },
        "version": { "type": "string", "maxLength": 60 },
        "entryNodeId": { "type": "string", "minLength": 1 },
        "nodes": { "type": "array", "minItems": 1, "maxItems": 60, "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/edge" } },
        "manager": {
          "type": "object",
          "additionalProperties": false,
          "required": ["memberId"],
          "properties": {
            "memberId": { "type": "string", "maxLength": 64 },
            "maxDelegationDepth": { "type": "integer", "minimum": 1, "maximum": 8 },
            "maxParallelTasks": { "type": "integer", "minimum": 1, "maximum": 16 },
            "allowDynamicTaskCreation": { "type": "boolean" },
            "requireCompletionReview": { "type": "boolean" }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxDurationMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
            "maxNodeRuns": { "type": "integer", "minimum": 1, "maximum": 100 },
            "maxIterations": { "type": "integer", "minimum": 1, "maximum": 100 },
            "maxConcurrentTasks": { "type": "integer", "minimum": 1, "maximum": 16 },
            "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
            "backoffMs": { "type": "integer", "minimum": 0, "maximum": 600000 },
            "retryBackoffMultiplier": { "type": "number", "minimum": 1, "maximum": 10 }
          }
        }
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "const": "orchestrator-mediated" },
        "allowPeerToPeer": { "type": "boolean" },
        "persistMessages": { "type": "boolean" },
        "maxRounds": { "type": "integer", "minimum": 1, "maximum": 20 },
        "contextPolicy": { "enum": ["thread-and-artifacts", "artifacts-only"] },
        "verbosity": { "enum": ["minimal", "concise", "normal"], "description": "Chat discipline. Progress is tracked on the board, not in chat." },
        "maxMessagesPerTurn": { "type": "integer", "minimum": 0, "maximum": 20 },
        "maxBodyChars": { "type": "integer", "minimum": 120, "maximum": 20000 }
      }
    }
  }
}
